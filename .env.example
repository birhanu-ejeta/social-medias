# Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# NextAuth - change NEXTAUTH_URL to your production domain
NEXTAUTH_URL=https://your-app.vercel.app
NEXTAUTH_SECRET=your_secret_here_generate_with_openssl_rand_base64_32

# Optional JWT
JWT_SECRET=your_jwt_secret_here

# Pusher (real-time messaging)
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_CLUSTER=your_pusher_cluster

# UploadThing (file uploads)
UPLOADTHING_TOKEN=your_uploadthing_token
UPLOADTHING_SECRET=your_uploadthing_secret
UPLOADTHING_APP_ID=your_uploadthing_app_id

# Hate Speech Detection API
HATE_SPEECH_API_URL=https://your-ml-api.com/api
HATE_SPEECH_API_KEY=your_api_key

NEXT_PUBLIC_HATE_SPEECH_API_URL=https://your-ml-api.com/api
NEXT_PUBLIC_HATE_SPEECH_API_KEY=your_api_key
